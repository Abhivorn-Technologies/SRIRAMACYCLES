# MongoDB Database Connection
# Replace with your MongoDB connection URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sriramacycles?retryWrites=true&w=majority
MONGODB_DB_NAME=sriramacycles

# Default Admin Credentials (Used by seed script: npm run seed)
ADMIN_EMAIL=admin@sriramacycles.com
ADMIN_PASSWORD=your_secure_admin_password_here

# JWT Secret for Session Authentication (Generate a strong random secret)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
